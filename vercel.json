{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "type": "service", "service": "web" } }
  ],
  "crons": [
    { "path": "/api/cron/reconcile", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/crm-sync", "schedule": "*/2 * * * *" }
  ]
}
